# Copy to .env, or run `npm run setup` to fill this in interactively.
# .env is gitignored. Never commit real values.

# Server
API_PORT=8787
API_HOST=127.0.0.1
DB_PATH=./data/agents-jones.sqlite

# monday agents (live)
MONDAY_API_TOKEN=
# Your account's web address, used for links, e.g. https://your-account.monday.com
MONDAY_ACCOUNT_URL=
# Agent ids, comma separated. Not the user id in the agent editor URL; setup can convert one.
MONDAY_AGENT_IDS=
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_MCP_URL=https://mcp.monday.com/mcp
MONDAY_POLL_SECONDS=120

# Sphera agents (live)
# Agent Factory API base, e.g. https://agent-factory.example.com/v2
SPHERA_API_URL=
# Agent page base for links, e.g. https://sphera.example.com/agentic-builders/agents
SPHERA_UI_URL=
SPHERA_AGENT_IDS=
# Optional: only needed to PATCH owner-only prompts. Never commit.
SPHERA_SESSION_COOKIE=
# Optional: GitHub login of the agent's bot, used to attribute repo activity to turns
SPHERA_GITHUB_ACTOR=
# Optional: read-only GitHub token for the fallback above. Never commit.
GITHUB_TOKEN=

# How often to poll Sphera, in seconds
SPHERA_POLL_SECONDS=120

# Mock adapters (claude, cursor)
MOCK_AGENTS=true

# Team Brain (placeholder, not wired yet)
TEAM_BRAIN_MCP_URL=

# Private building names and slots (written by setup)
LOCATIONS_FILE=../../locations.local.json
